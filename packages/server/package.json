  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "brotli": "^1.3.3",
    "hono": "^4.9.9",
    "md5": "^2.3.0",
    "nostr-tools": "^2.17.0"
  }
