{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "inputs": ["**/*.ts"]
    },
    "test": {
      "inputs": ["**/*.ts"]
    },
    "dev": {
      "inputs": ["**/*.ts"]
    },
    "start": {
      "inputs": ["**/*.ts"]
    },
    "publish": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": []
    }
  }
}
